# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── CAD 生成物 / 缓存 ───────────────────────────────────────
# STEP/DXF/GLB 视项目约定：源文件入仓，生成物可选入仓
# 若不想入库生成物，取消下一行注释
# STEP/*.step
# STL/*.stl

# cadgen 探测与缓存
.cadgen/
*.cadgen/

# ── 探索性产物（skill 约定：tmp/ 是 ignored exploratory scripts）──
# 忽略 tmp/ 里的内容，但保留空目录占位
**/tmp/*
!**/tmp/.gitkeep
!docs/images/

# ── 渲染输出 ────────────────────────────────────────────────
*.png.tmp

# ── 机器人描述缓存 ──────────────────────────────────────────
*.urdf.xacro.bak

# ── OS ──────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── 编辑器 ──────────────────────────────────────────────────
.idea/
.vscode/
*.swp
